<ResourceDictionary
    x:Class="AmbientSounds.ResourceDictionaries.SharedTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="using:Microsoft.Toolkit.Uwp.UI.Animations"
    xmlns:controls="using:AmbientSounds.Controls"
    xmlns:converters="using:AmbientSounds.Converters"
    xmlns:ex="using:JeniusApps.Common.UI.Uwp"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:ui="using:Microsoft.Toolkit.Uwp.UI"
    xmlns:viewmodels="using:AmbientSounds.ViewModels"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls">

    <DataTemplate x:Key="FocusSegmentTemplate" x:DataType="viewmodels:FocusSegmentViewModel">
        <Grid x:Name="ItemGrid" HorizontalAlignment="Stretch">
            <winui:ProgressBar
                Margin="1,0"
                IsIndeterminate="False"
                Value="{x:Bind Progress, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="FocusSegmentItemsPanel">
        <toolkit:UniformGrid Rows="1" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="TaskFlipViewItemTemplate" x:DataType="viewmodels:FocusTaskViewModel">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Padding="20,12" CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CheckBox HorizontalAlignment="Stretch" IsChecked="{x:Bind IsCompleted, Mode=TwoWay}">
                    <TextBlock Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind DisplayTitle}" />
                </CheckBox>
                <Grid Grid.Row="1">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Text}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ex:UIExtensions.InvertBoolToVis(IsCompleted), Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Text}"
                        TextDecorations="Strikethrough"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="HorizontalSnappingListView" TargetType="ListView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="IsSwipeEnabled" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.IsHorizontalRailEnabled" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="True" />
        <Setter Property="ScrollViewer.ZoomMode" Value="Disabled" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!--  this was changed to horizontal  -->
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <!--  this was changed to add the two snap properties  -->
                        <ScrollViewer
                            x:Name="ScrollViewer"
                            AutomationProperties.AccessibilityView="Raw"
                            BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            HorizontalSnapPointsAlignment="Near"
                            HorizontalSnapPointsType="Mandatory"
                            IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                            IsHorizontalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsHorizontalScrollChainingEnabled}"
                            IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                            IsVerticalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsVerticalScrollChainingEnabled}"
                            TabNavigation="{TemplateBinding TabNavigation}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}">
                            <ItemsPresenter
                                Padding="{TemplateBinding Padding}"
                                Footer="{TemplateBinding Footer}"
                                FooterTemplate="{TemplateBinding FooterTemplate}"
                                FooterTransitions="{TemplateBinding FooterTransitions}"
                                Header="{TemplateBinding Header}"
                                HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                HeaderTransitions="{TemplateBinding HeaderTransitions}" />
                        </ScrollViewer>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SnappingGridViewStyle" TargetType="GridView">
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.IsHorizontalRailEnabled" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
        <Setter Property="ScrollViewer.IsVerticalRailEnabled" Value="True" />
        <Setter Property="ScrollViewer.ZoomMode" Value="Disabled" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="True" />
        <Setter Property="IsSwipeEnabled" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ScrollViewer
                            x:Name="ScrollViewer"
                            AutomationProperties.AccessibilityView="Raw"
                            BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                            IsHorizontalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsHorizontalScrollChainingEnabled}"
                            IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                            IsVerticalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsVerticalScrollChainingEnabled}"
                            TabNavigation="{TemplateBinding TabNavigation}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            VerticalSnapPointsAlignment="Near"
                            VerticalSnapPointsType="Mandatory"
                            ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}">
                            <ItemsPresenter
                                Padding="{TemplateBinding Padding}"
                                Footer="{TemplateBinding Footer}"
                                FooterTemplate="{TemplateBinding FooterTemplate}"
                                FooterTransitions="{TemplateBinding FooterTransitions}"
                                Header="{TemplateBinding Header}"
                                HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                HeaderTransitions="{TemplateBinding HeaderTransitions}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="OnlineSoundPanelTemplate">
        <toolkit:WrapPanel HorizontalSpacing="{StaticResource SoundCardSpacingDouble}" VerticalSpacing="{StaticResource SoundCardSpacingDouble}" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="OnlineSoundDataTemplate" x:DataType="viewmodels:OnlineSoundViewModel">
        <Grid
            AutomationProperties.Name="{x:Bind converters:LocalizationConverter.ConvertOnlineSoundListViewName(Name, NotInstalled), Mode=OneWay}"
            PointerEntered="{x:Bind controls:UIHelper.ScaleUpChildImage}"
            PointerExited="{x:Bind controls:UIHelper.ScaleNormalChildImage}">
            <ani:Implicit.ShowAnimations>
                <ani:OpacityAnimation
                    Delay="0:0:0.1"
                    From="0"
                    To="1"
                    Duration="0:0:1" />
            </ani:Implicit.ShowAnimations>

            <Grid Width="132" CornerRadius="{StaticResource SoundCardCornerRadius}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="ImageGrid"
                    Height="{StaticResource ImageCardHeight}"
                    ui:VisualExtensions.NormalizedCenterPoint="0.5"
                    CornerRadius="{StaticResource SoundCardCornerRadius}">
                    <ani:Implicit.Animations>
                        <ani:ScaleAnimation Duration="0:0:0.3" />
                    </ani:Implicit.Animations>
                    <Grid.Background>
                        <ImageBrush Stretch="UniformToFill">
                            <ImageBrush.ImageSource>
                                <BitmapImage
                                    DecodePixelType="Logical"
                                    DecodePixelWidth="200"
                                    UriSource="{x:Bind ImagePath, Mode=OneWay}" />
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Grid.Background>
                </Grid>

                <Rectangle Stretch="Fill" Tapped="OnGridTapped">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.4" Color="{x:Bind controls:UIHelper.ToTransparent(ColourHex), Mode=OneWay}" />
                            <GradientStop Offset="1" Color="{x:Bind controls:UIHelper.ToColour(ColourHex), Mode=OneWay}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Fill="{x:Bind ColourHex, Mode=OneWay}"
                    Stretch="Fill" />

                <Grid
                    Grid.Row="1"
                    Height="36"
                    RequestedTheme="Dark">
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MaxLines="2"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid
                    Grid.Row="2"
                    Height="40"
                    RequestedTheme="Dark">
                    <Grid
                        Margin="6,0,6,6"
                        ColumnSpacing="{x:Bind controls:UIHelper.PreviewColumnSpan(CanPreview)}"
                        Visibility="{x:Bind NotInstalled, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Bind controls:UIHelper.PreviewButtonColumnWidth(CanPreview)}" />
                        </Grid.ColumnDefinitions>

                        <!--  buy button  -->
                        <Button
                            x:Uid="BuyButton"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{x:Bind BuySoundCommand, Mode=OneWay}"
                            Visibility="{x:Bind CanBuy, Mode=OneWay}">
                            <FontIcon
                                FontFamily="{StaticResource FluentUIGlyphs}"
                                FontSize="{StaticResource SmallIconSize}"
                                Glyph="{StaticResource GlyphUnlock}" />
                        </Button>

                        <!--  download button  -->
                        <Button
                            x:Uid="DownloadSoundButton"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{x:Bind DownloadCommand, Mode=OneWay}"
                            Visibility="{x:Bind DownloadButtonVisible, Mode=OneWay}">
                            <FontIcon
                                FontFamily="{StaticResource FluentUIGlyphs}"
                                FontSize="16"
                                Glyph="{StaticResource GlyphDownload}" />
                        </Button>

                        <!--  preview button  -->
                        <Button
                            x:Uid="PreviewButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{x:Bind PreviewCommand}"
                            Visibility="{x:Bind CanPreview, Mode=OneWay}">
                            <FontIcon
                                Margin="6,0,0,0"
                                FontFamily="{StaticResource FluentUIGlyphs}"
                                Glyph="{StaticResource GlyphVolumeSmall}" />
                        </Button>

                        <Grid
                            Grid.ColumnSpan="2"
                            ui:VisualExtensions.NormalizedCenterPoint="0.5"
                            Visibility="{x:Bind DownloadProgressVisible, Mode=OneWay}">
                            <ani:Implicit.ShowAnimations>
                                <ani:OpacityAnimation
                                    From="0"
                                    To="1"
                                    Duration="0:0:0.3" />
                                <ani:ScaleAnimation
                                    From="0.6"
                                    To="1"
                                    Duration="0:0:0.3" />
                            </ani:Implicit.ShowAnimations>

                            <winui:ProgressRing
                                Width="16"
                                Height="16"
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                IsIndeterminate="False"
                                Value="100" />
                            <winui:ProgressRing
                                Width="16"
                                Height="16"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                IsIndeterminate="False"
                                Visibility="{x:Bind DownloadProgressVisible, Mode=OneWay}"
                                Value="{x:Bind DownloadProgressValue, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <Button
                        Margin="6,0,6,6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ui:VisualExtensions.NormalizedCenterPoint="0.5"
                        Command="{x:Bind PlayCommand, Mode=OneWay}"
                        Visibility="{x:Bind IsInstalled, Mode=OneWay}">
                        <ani:Implicit.ShowAnimations>
                            <ani:OpacityAnimation
                                From="0"
                                To="1"
                                Duration="0:0:0.3" />
                            <ani:ScaleAnimation
                                From="0.8"
                                To="1"
                                Duration="0:0:0.3" />
                        </ani:Implicit.ShowAnimations>

                        <FontIcon
                            FontFamily="{StaticResource FluentUIGlyphs}"
                            FontSize="{StaticResource SmallIconSize}"
                            Glyph="{StaticResource GlyphPlay}" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
